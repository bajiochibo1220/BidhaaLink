# Runtime PostgreSQL connection: direct Neon URI for the long-running Render service
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require

# Migration connection: same Neon direct endpoint
DIRECT_URL=postgresql://USER:PASSWORD@YOUR-NEON-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_SCHEMA=business_website

JWT_SECRET=generate-a-long-random-value
NODE_ENV=production
PORT=10000
BASE_URL=https://my-business-website-api.onrender.com
CLIENT_URL=https://YOUR-VERCEL-DOMAIN.vercel.app

# Gemini AI assistant. Product matching works from live BidhaaLink listings without a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Cloudinary (same account and values as your existing setup)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional integrations; only configure services you use
REDIS_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SENDGRID_API_KEY=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=https://my-business-website-api.onrender.com/api/payments/mpesa-callback
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_ENVIRONMENT=sandbox
AIRTEL_CALLBACK_URL=https://my-business-website-api.onrender.com/api/payments/airtel-callback
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
